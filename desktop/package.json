{
  "name": "suoyu-console",
  "version": "2.9.0",
  "private": true,
  "description": "天鉴·索舆 — 资产侦察与信息收集作战台（内置本地引擎，安装版随包携带工具链）",
  "main": "main.js",
  "author": "Hackbiao",
  "scripts": {
    "start": "electron .",
    "dist:portable": "electron-builder --win portable --x64",
    "dist:installer": "electron-builder --win nsis --x64 --config electron-builder.installer.yml",
    "dist": "npm run dist:portable && npm run dist:installer"
  },
  "devDependencies": {
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8"
  }
}
